<mxfile host="app.diagrams.net"><diagram id="netzplan" name="Netzplan"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" landscape="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;M306 · Netzplan (CPM) Quellfassung&lt;/b&gt;&lt;br&gt;Dauer D in Wochen. Pfeile ziehen: Maus über ein Kästchen, am blauen Pfeil ziehen bis zum Nachfolger. Felder per Doppelklick ausfüllen. Kästchen frei verschieben. Kritischen Pfad rot markieren (Pfeil markieren → Linienfarbe). Export: Datei → Exportieren als → PDF." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="60" as="geometry"/></mxCell><mxCell id="c1" value="" style="group;" vertex="1" connectable="1" parent="1"><mxGeometry x="860" y="20" width="180" height="100" as="geometry"/></mxCell><mxCell id="c2" value="FAZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#333333;fontSize=11;" vertex="1" parent="c1"><mxGeometry x="0" y="0" width="60" height="30" as="geometry"/></mxCell><mxCell id="c3" value="D" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B4A7D6;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="60" y="0" width="60" height="30" as="geometry"/></mxCell><mxCell id="c4" value="FEZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5C3E0;strokeColor=#333333;fontSize=11;" vertex="1" parent="c1"><mxGeometry x="120" y="0" width="60" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Bezeichnung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="c1"><mxGeometry x="0" y="30" width="180" height="40" as="geometry"/></mxCell><mxCell id="c6" value="SAZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B7D3E8;strokeColor=#333333;fontSize=11;"